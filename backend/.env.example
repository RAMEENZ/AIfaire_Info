# Exemple de configuration du BACKEND, à copier en `backend/.env` pour un
# lancement local (`uvicorn app.main:app`).
#
# ATTENTION — ce fichier est lu comme un fichier .env par pydantic-settings, qui
# refuse toute clé inconnue (`extra='forbid'`). Une clé qui n'est PAS un réglage
# de `app/config.py` doit donc rester commentée, sinon le backend ne démarre
# plus. C'est ce qui s'était produit avec les SCHEDULER_HOUR_* laissés ici après
# leur remplacement par INGEST_HOURS / BRIEF_HOURS.
#
# Le `.env` de la RACINE est un autre fichier : c'est celui que docker-compose
# lit (POSTGRES_PASSWORD, CLOUDFLARE_TUNNEL_TOKEN…). Il transmet ses valeurs au
# conteneur comme variables d'environnement, que pydantic ignore quand il ne les
# connaît pas — la contrainte ci-dessus ne vaut que pour CE fichier.
#
# Référence exhaustive des réglages : tableau « Variables d'environnement
# backend » du README.

DATABASE_URL=postgresql+asyncpg://faire_info:password@localhost:5432/faire_info

APP_ENV=development
LOG_LEVEL=INFO

# Documentation interactive (Swagger /docs, ReDoc /redoc, /openapi.json).
# Désactivée par défaut pour ne pas exposer la surface API. true en local.
ENABLE_DOCS=false

# Clé protégeant POST /api/ingest/run et /api/brief/run. Vide = pas d'auth (dev).
# En prod, générer une valeur forte : openssl rand -hex 24
INGEST_API_KEY=

# ── Modèles ───────────────────────────────────────────────────────────────────
# Mistral est prioritaire sur Ollama quand la clé est renseignée.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Tentatives par appel, reprises comprises (1 = pas de reprise). Un HTTP 429
# n'est pas une panne : il se résout en patientant.
MISTRAL_MAX_RETRIES=4
MISTRAL_MAX_CONCURRENCY=4
# Espacement minimal entre deux départs de requête : c'est le vrai garde-fou
# contre la limitation de débit, la reprise seule n'y suffit pas. 0 = désactivé.
MISTRAL_MIN_INTERVAL_SECONDS=1.0

# Ollama : repli local quand MISTRAL_API_KEY est vide. Vide = pas de repli.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:1.5b

METEO_FRANCE_API_KEY=

# ── Ordonnanceur ──────────────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Europe/Paris
# Heures des ingestions complètes (heure locale du fuseau ci-dessus).
# Format : heures séparées par des virgules.
INGEST_HOURS=7,12,19
# Heures de génération du brief : chacune suit son ingestion de deux heures.
BRIEF_HOURS=9,14,21
# Passage horaire des sources d'alerte (météo, crues, séismes), sans coût LLM.
HOURLY_ALERT_INGESTION=true

# ── Collecte ──────────────────────────────────────────────────────────────────
# Consulte le robots.txt de l'hôte avant de télécharger le CORPS d'un article.
# Sans effet sur la lecture des flux RSS eux-mêmes.
RESPECT_ROBOTS_TXT=true
# Télécharger le contenu complet des articles avant extraction IA.
FETCH_FULL_ARTICLES=true
# Plafond d'articles de presse traités par cycle (chacun coûte un appel LLM).
MAX_PRESSE_ARTICLES=120
# Délai maximal accordé à la phase de collecte d'UN connecteur.
CONNECTOR_FETCH_TIMEOUT_SECONDS=120
# Intervalle minimal entre deux requêtes vers un même hôte. 0 = désactivé.
FEED_HOST_MIN_INTERVAL_SECONDS=0.3
# Circuit-breaker des flux RSS : échecs consécutifs avant mise à l'écart, et
# nombre de cycles d'ingestion sautés avant re-test.
FEED_FAILURE_THRESHOLD=3
FEED_SKIP_RUNS=8
# Écarte les articles d'affiliation des flux de presse (bons plans, promos).
FILTER_COMMERCIAL_CONTENT=true

# ── API ───────────────────────────────────────────────────────────────────────
DEFAULT_SINCE_HOURS=48
DEFAULT_EVENTS_LIMIT=500
MAX_EVENTS_LIMIT=1000

# Plafond de flux SSE /events/stream simultanés (au-delà : 503, repli polling).
MAX_SSE_CONNECTIONS=100

# CORS : origines autorisées, séparées par des virgules.
# "*" = toutes (API publique en lecture seule) ; neutralisé en production.
#
# L'application Android (mobile/) est pour l'API une origine TIERCE : sa
# WebView sert les fichiers embarqués depuis https://localhost. Sans cette
# origine dans la liste, l'application s'ouvre mais reste vide — l'API ne
# renvoie alors aucun Access-Control-Allow-Origin et le navigateur jette les
# réponses. Pour la servir, en production :
#   CORS_ORIGINS=https://votre-domaine,https://localhost
CORS_ORIGINS=*

# Cache Redis. Vide = cache désactivé. En production : redis://redis:6379
REDIS_URL=
REDIS_EVENTS_TTL=120

# ── Supervision ───────────────────────────────────────────────────────────────
# Healthcheck de fraîcheur (GET /healthz) : unhealthy si aucun événement
# ingéré depuis HEALTHZ_MAX_DATA_AGE_HOURS ou si la prochaine ingestion
# planifiée est en retard de plus de HEALTHZ_SCHEDULER_GRACE_MINUTES.
HEALTHZ_MAX_DATA_AGE_HOURS=26
HEALTHZ_SCHEDULER_GRACE_MINUTES=60
HEALTHZ_BOOT_GRACE_MINUTES=30

# Webhook de notification (Discord, Slack, ntfy…) : panne chronique d'un
# connecteur, rétablissement, et alerte de fraîcheur des données.
WEBHOOK_URL=
WEBHOOK_THRESHOLD=3

# Logs persistants (vide = stdout uniquement). En prod : /app/logs (volume ./logs).
LOG_DIR=

# Notifications Web Push (optionnel). Générer une paire une seule fois :
#   docker compose exec backend python -m app.maintenance vapid-keys
# Sans ces valeurs, la fonctionnalité est inerte (endpoints 503, bouton masqué).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# ── Réglages lus par docker-compose, PAS par le backend ───────────────────────
# À placer dans le .env de la RACINE. Les laisser décommentés ICI empêcherait
# le backend de démarrer (voir l'avertissement en tête de fichier).
# POSTGRES_PASSWORD=
# CLOUDFLARE_TUNNEL_TOKEN=
