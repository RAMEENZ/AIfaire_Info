NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Affiche le bouton « Ingérer » (déclenchement manuel de l'ingestion) dans la
# barre de statut. À réserver au dev/local : en production, l'endpoint est
# protégé par INGEST_API_KEY (que le front public ne peut pas transmettre).
NEXT_PUBLIC_ENABLE_INGEST_BUTTON=true

# Origine publique du site. Racine des URL absolues des métadonnées : og:image
# doit être joignable depuis l'extérieur, faute de quoi les aperçus de partage
# (WhatsApp, Slack, Mastodon) restent vides. En production, docker-compose la
# fournit ; en local la valeur par défaut suffit.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
